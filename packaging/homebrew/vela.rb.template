class Vela < Formula
  desc "WASM Component Model optimizer"
  homepage "https://github.com/mizzy/vela"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/mizzy/vela/releases/download/v{{VERSION}}/vela-{{VERSION}}-macos-aarch64.tar.gz"
      sha256 "{{MACOS_ARM_SHA256}}"
    else
      url "https://github.com/mizzy/vela/releases/download/v{{VERSION}}/vela-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{MACOS_X86_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/mizzy/vela/releases/download/v{{VERSION}}/vela-{{VERSION}}-linux-aarch64.tar.gz"
      sha256 "{{LINUX_ARM_SHA256}}"
    else
      url "https://github.com/mizzy/vela/releases/download/v{{VERSION}}/vela-{{VERSION}}-linux-x86_64.tar.gz"
      sha256 "{{LINUX_X86_SHA256}}"
    end
  end

  def install
    bin.install "vela"
  end

  test do
    assert_match "vela", shell_output("#{bin}/vela --version")
  end
end
